# Copy to ./.offload.env (per project) or ~/.config/offload/config (global).
# Env vars always win over these files.

# Which CLI runs the worker.  auto = match the agent you are running under,
# else the first installed of: claude, codex, antigravity, grok, ollama
OFFLOAD_PROVIDER=auto

# Mix providers per role if you like:
# OFFLOAD_READ_PROVIDER=codex
# OFFLOAD_WRITE_PROVIDER=claude

# Provider defaults for read / write:
#   claude       claude-sonnet-5        / claude-sonnet-5
#   codex        gpt-5.6-luna           / gpt-5.6-terra
#   antigravity  gemini-3.8-flash-low   / gemini-3.1-pro-low     (agy models — free Starter quota)
#   grok         CLI default            / CLI default
#   ollama       qwen3:8b               / qwen3:8b               (local, offline, no account)
#   cursor       gemini-3.8-flash       / claude-sonnet-5         (37 models via one key, ~60-90s/call)
# OFFLOAD_READ_MODEL=gpt-5.6-luna
# OFFLOAD_WRITE_MODEL=gpt-5.6-terra

OFFLOAD_READ_EFFORT=low
OFFLOAD_WRITE_EFFORT=medium

# Hook threshold (lines). Reads at or below this pass through.
OFFLOAD_MIN_LINES=350

# For `offload-gain`: $ per 1M input tokens of your MAIN model (Fable 5.1 = 10, Opus 5 = 5)
OFFLOAD_MAIN_RATE=10

# Path to the savings ledger
# OFFLOAD_LEDGER=~/.local/share/offload/ledger.jsonl

# Show the worker CLI's stderr when a call fails (set to 1)
# OFFLOAD_DEBUG=1

# Auto-pick the worker one tier below the model driving your session.
# Space-separated "pattern:worker" pairs; first pattern matching the main model wins.
# Explicit OFFLOAD_READ_MODEL / OFFLOAD_WRITE_MODEL always override this.
# OFFLOAD_MODEL_MAP="opus:claude-sonnet-5 fable:claude-sonnet-5 sonnet:claude-haiku-4-5 terra:gpt-5.6-luna sol:gpt-5.6-luna"

# Never send more than this to a worker in one call. A provider with a lower hard
# ceiling (antigravity: 117KB) wins over this.
OFFLOAD_MAX_BYTES=600000

# The cursor provider is a REST API, not a CLI — it needs a key.
# Create one at cursor.com -> Settings -> API Keys. Keep it in the GLOBAL config
# (~/.config/offload/config), never in a repo.
# CURSOR_API_KEY=crsr_...
